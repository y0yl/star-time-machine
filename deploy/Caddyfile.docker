# 星空的时间机器 — reverse proxy (Caddy 2). HTTPS is automatic for a public
# domain; replace the domain and sub-path below (no secrets in this file).
#   STM_DOMAIN   e.g. stm.example.edu.cn
#   STM_SUBPATH  e.g. /stm   (empty for the root)
{$STM_DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path {$STM_SUBPATH:}/* {
		# static fast path: octree nodes are pre-compressed with brotli
		@node path_regexp node ^/api/nodes/(\d+)$
		handle @node {
			@unfiltered not query f=*
			handle @unfiltered {
				root * /srv/stm/data/build/octree/nodes
				rewrite * /{re.node.1}.bin
				header Cache-Control "public, max-age=86400"
				file_server {
					precompressed br
				}
			}
			reverse_proxy app:8787
		}
		handle /api/* {
			reverse_proxy app:8787
		}
		handle /ws/* {
			reverse_proxy app:8787
		}
		handle /s/* {
			reverse_proxy app:8787
		}
		handle {
			root * /srv/stm/web/dist
			@assets path /assets/* /fonts/* /data/*
			header @assets Cache-Control "public, max-age=604800"
			try_files {path} /index.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
